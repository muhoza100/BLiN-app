rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'muhoza.co.org.ug@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- User Profile Validation ---
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 64 &&
             data.username is string && data.username.size() <= 32 &&
             data.pointsBalance is number &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == request.auth.uid;
      allow update: if (isOwner(userId) || isAdmin()) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() || isOwner(userId);
    }

    // --- Game Scores Leaderboard ---
    function isValidGameScore(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 64 &&
             data.score is number &&
             data.gameMode is string && data.gameMode.size() <= 32 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /game_scores/{scoreId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(scoreId) &&
                       isValidGameScore(incoming()) &&
                       incoming().userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // --- AI Omni Generated Videos ---
    function isValidGeneratedVideo(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.prompt is string && data.prompt.size() <= 1000 &&
             data.videoUrl is string &&
             data.aspectRatio is string && data.aspectRatio.size() <= 16 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /generated_videos/{videoId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(videoId) &&
                       isValidGeneratedVideo(incoming()) &&
                       incoming().userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // --- Saved Places (Google Maps Grounded) ---
    function isValidSavedPlace(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.placeName is string && data.placeName.size() <= 128 &&
             data.formattedAddress is string && data.formattedAddress.size() <= 256 &&
             data.category is string && data.category.size() <= 64 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /saved_places/{placeId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(placeId) &&
                       isValidSavedPlace(incoming()) &&
                       incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(placeId) &&
                       isValidSavedPlace(incoming()) &&
                       existing().userId == request.auth.uid;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }
  }
}
